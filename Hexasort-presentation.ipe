<text layer="alpha" matrix="1 0 0 1 0 16" transformations="translations" pos="16 496" stroke="black" type="minipage" width="784" height="86.2568" depth="72.436" valign="top">\hl{3-Partition}\\
\textbf{Input:} A multiset $A$ of $3m$ positive integers and a bound $B \in Z^+$.\\
\textbf{Task:} Can $A$ be partitioned into $m$ triplets $A_1, A_2, \dots, A_m$ such that each triplet sums up to exactly $B$.
\begin{itemize}
\item is strongly NP-hard
\end{itemize}
</text>
