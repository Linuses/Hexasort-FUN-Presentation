<text layer="Partition-Problem-Definition" transformations="translations" pos="16 496" stroke="black" type="minipage" width="784" height="69.5268" depth="55.692" valign="top">\hl{Partition}\\
\textbf{Input:} A multiset $P$ of positive integers $p_1, p_2, \dots, p_n$.\\
\textbf{Task:} Can $P$ be split into two equal-sum parts?
\begin{itemize}
\item is weakly NP-hard
\end{itemize}
</text>
<text layer="Reduction" matrix="1 0 0 1 224 4" transformations="translations" pos="240 176" stroke="black" type="minipage" width="448" height="20.9244" depth="6.972" valign="top">$S = \langle(\text{black}, p_1),\dots, (\text{black}, p_n)\rangle$</text>
<text matrix="1 0 0 1 224 52" transformations="translations" pos="240 80" stroke="black" type="minipage" width="160" height="20.9244" depth="6.972" valign="top">$t = \sum P / 2$</text>
<path matrix="1 0 0 1 -272 4" stroke="black" rarrow="normal/normal">
704 160 m
592 160 l
</path>
<text matrix="1 0 0 1 0 20" transformations="translations" pos="32 160" stroke="black" type="minipage" width="256" height="20.9244" depth="6.972" valign="top">$P =  \langle p_1, p_2, \dots, p_n\rangle$</text>
<text layer="theorem" matrix="1 0 0 1 -32 48" transformations="translations" pos="48 32" stroke="black" type="minipage" width="832" height="36.0948" depth="22.176" valign="top">\textbf{Theorem 1:} \hl{Empty Hexasort} on two independent edges and a single color is weakly NP-hard.</text>
<text layer="Reduction" matrix="1 0 0 1 0 -32" transformations="translations" pos="16 336" stroke="black" type="minipage" width="256" height="16.6824" depth="2.688" valign="top">\hl{Reduction:}</text>
